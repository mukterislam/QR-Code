<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_unlock"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/unlock_title"
            app:titleTextColor="@color/text_primary_dark" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Lock Icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Security Lock"
                android:src="@drawable/ic_lock"
                app:tint="@color/accent_purple" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_title"
                android:textColor="@color/text_primary_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/unlock_desc"
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp" />

            <!-- Input Box -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_unlock_password"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/label_password"
                app:boxStrokeColor="@color/accent_purple"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/accent_purple">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_unlock_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary_dark" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error Banner -->
            <TextView
                android:id="@+id/tv_unlock_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#20EF4444"
                android:padding="12dp"
                android:text="@string/error_decryption_failed"
                android:textColor="@color/error"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Unlock CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_unlock"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_decrypt"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_purple" />

            <!-- Decrypted Result Container -->
            <LinearLayout
                android:id="@+id/layout_decrypted_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/unlock_success"
                    android:textColor="@color/success"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_decrypted_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_subtle_dark"
                    android:padding="14dp"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_decrypted"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Copy to Clipboard"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_blue"
                    app:strokeColor="@color/accent_blue" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
