<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rounded_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/iv_item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@color/surface_subtle_dark"
        android:contentDescription="Type Icon"
        android:padding="8dp"
        android:src="@drawable/ic_qr_code"
        app:tint="@color/accent_blue" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="My Wi-Fi Network"
            android:textColor="@color/text_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="WIFI:S:OfficeNet;T:WPA..."
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_item_lock_badge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Private Badge"
        android:src="@drawable/ic_lock"
        android:visibility="gone"
        app:tint="@color/accent_purple" />

    <ImageView
        android:id="@+id/iv_item_favorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Favorite"
        android:src="@drawable/ic_shield"
        app:tint="@color/text_secondary_dark" />
</LinearLayout>
